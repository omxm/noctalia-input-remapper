#!/usr/bin/python3 -I
"""Hide a game controller from user programs while input-remapper runs it.

usage: noctalia-padhide hide|show NAME

Meant to be installed root-owned (see README, "Hiding the original
controller") and run through sudo by the Noctalia plugin.

  hide  Every gamepad node named NAME - the real controller and
        input-remapper's forwarded copy, both carry the name - becomes
        root-only (mode 0600, ACL removed), and every fd a non-root process
        already holds on it is revoked (EVIOCREVOKE through pidfd_getfd).
        input-remapper runs as root and keeps its fds, so it keeps reading.
        Games using SDL drop a revoked controller and skip one they cannot
        open, so they only see input-remapper's virtual gamepad.
  show  Mode back to 0660, then udev "change" on the same nodes, which
        restores the seat user's ACL (elogind / systemd uaccess). udev does
        not re-apply the mode on "change", hence the chmod.

A node that disappears midway (input-remapper recreates its forwarded copy
whenever a preset starts) is skipped; the plugin runs this again on its next
refresh if anything is still left to do.

Only /dev/input/eventN character devices that the kernel lists as a joystick
(they have a jsN sibling) and whose name is exactly NAME are touched.
"""
import ctypes
import errno
import fcntl
import os
import re
import stat
import subprocess
import sys

INPUT_MAJOR = 13
EVIOCREVOKE = 0x40044591
SYS_PIDFD_GETFD = 438  # x86_64 and most other architectures
UDEVADM = "/usr/bin/udevadm"
libc = ctypes.CDLL(None, use_errno=True)


def fail(message, code=1):
    print(f"noctalia-padhide: {message}", file=sys.stderr)
    sys.exit(code)


def valid_name(name):
    return (
        0 < len(name) <= 255
        and name.isprintable()
        # never the virtual pad input-remapper writes to
        and not name.startswith("input-remapper")
    )


def nodes(name):
    """Device paths of the gamepad nodes named exactly `name`, checked."""
    found = []
    for entry in sorted(os.listdir("/sys/class/input")):
        if not re.fullmatch(r"event[0-9]+", entry):
            continue
        sysdir = f"/sys/class/input/{entry}"
        try:
            with open(f"{sysdir}/device/name") as f:
                if f.read().rstrip("\n") != name:
                    continue
            if not any(re.fullmatch(r"js[0-9]+", e) for e in os.listdir(f"{sysdir}/device")):
                continue
            with open(f"{sysdir}/dev") as f:
                major, minor = (int(x) for x in f.read().strip().split(":"))
            path = f"/dev/input/{entry}"
            st = os.lstat(path)
        except (OSError, ValueError):
            continue
        if (
            major != INPUT_MAJOR
            or not stat.S_ISCHR(st.st_mode)
            or st.st_rdev != os.makedev(major, minor)
        ):
            continue
        found.append((path, sysdir, st.st_rdev))
    return found


def holders(rdev):
    """(pid, fd) of every non-root process holding the device open."""
    found = []
    for pid in filter(str.isdigit, os.listdir("/proc")):
        try:
            if os.stat(f"/proc/{pid}").st_uid == 0:
                continue
            fds = os.listdir(f"/proc/{pid}/fd")
        except OSError:
            continue
        for fd in fds:
            try:
                st = os.stat(f"/proc/{pid}/fd/{fd}")
            except OSError:
                continue
            if stat.S_ISCHR(st.st_mode) and st.st_rdev == rdev:
                found.append((int(pid), int(fd)))
    return found


def revoke(pid, fd):
    pidfd = os.pidfd_open(pid)
    try:
        dup = libc.syscall(SYS_PIDFD_GETFD, pidfd, fd, 0)
        if dup < 0:
            err = ctypes.get_errno()
            raise OSError(err, os.strerror(err))
        try:
            fcntl.ioctl(dup, EVIOCREVOKE, 0)
        finally:
            os.close(dup)
    finally:
        os.close(pidfd)


def hide(path, rdev):
    os.chmod(path, 0o600)
    try:
        os.removexattr(path, "system.posix_acl_access")
    except OSError as ex:
        if ex.errno != errno.ENODATA:
            raise
    for pid, fd in holders(rdev):
        try:
            revoke(pid, fd)
        except OSError as ex:
            # The process may have closed it or exited meanwhile.
            print(f"noctalia-padhide: {path}: pid {pid} fd {fd}: {ex}", file=sys.stderr)


def show(path, sysdir):
    os.chmod(path, 0o660)
    subprocess.run([UDEVADM, "trigger", "--action=change", sysdir], check=True)


def main():
    if len(sys.argv) != 3 or sys.argv[1] not in ("hide", "show"):
        fail("usage: noctalia-padhide hide|show NAME", 2)
    if os.geteuid() != 0:
        fail("must run as root (through sudo)", 2)
    command, name = sys.argv[1], sys.argv[2]
    if not valid_name(name):
        fail(f"refusing device name {name!r}", 2)

    found = nodes(name)
    if not found:
        fail(f"no gamepad named {name!r}")
    errors = []
    for path, sysdir, rdev in found:
        try:
            if command == "hide":
                hide(path, rdev)
            else:
                show(path, sysdir)
        except FileNotFoundError:
            continue  # gone meanwhile, nothing left to hide or show
        except (OSError, subprocess.CalledProcessError) as ex:
            errors.append(f"{path}: {ex}")
            continue
        print(f"{command} {path}")
    if command == "show":
        subprocess.run([UDEVADM, "settle", "--timeout=5"])
    if errors:
        fail("; ".join(errors))


main()
