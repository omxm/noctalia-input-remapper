#!/bin/sh
# ds4kbm-ctl start PRESET [ds4kbm options] | stop | status | analyze DIR
#
#   start    release the controller from input-remapper, then run ds4kbm.py
#            with the given input-remapper preset (presets/<device>/<name>.json).
#            A running instance is stopped first, so this also switches presets.
#   stop     stop ds4kbm.py and wait until the grab is gone
#   status   print "on" and the running preset's path, or "off" (exit 0 / 1)
#   analyze  print usable/skipped mapping counts for every preset in DIR (JSON)
#
# Environment:
#   DS4KBM_REMAPPER_CMD input-remapper control command (default: input-remapper-control)
DIR=$(dirname "$(readlink -f "$0")")
# must match run_prefix() in ds4kbm.py
if [ -n "$XDG_RUNTIME_DIR" ]; then RUN=$XDG_RUNTIME_DIR/ds4kbm; else RUN=/tmp/ds4kbm-$(id -u); fi
PIDFILE=$RUN.pid
LOG=$RUN.log
REMAPPER=${DS4KBM_REMAPPER_CMD:-input-remapper-control}

# serialize concurrent invocations (rapid clicks)
exec 9>"$RUN.lock"
flock 9

# ds4kbm.py holds an exclusive lock on its pidfile for as long as it runs and
# writes its own pid (line 1) and preset (line 2) there, so "locked" is the
# ground truth for "running".
running() {
    [ -f "$PIDFILE" ] && ! flock -n "$PIDFILE" true 2>/dev/null
}

start() {
    preset=$1
    shift
    [ -f "$preset" ] || { echo "no such preset: $preset" >&2; exit 1; }
    stop
    device=$(basename "$(dirname "$(readlink -f "$preset")")")
    # input-remapper must let go of the controller or the grab fails
    # (ds4kbm.py keeps retrying, so a slow release is harmless)
    $REMAPPER --command stop --device "$device" >/dev/null 2>&1
    setsid python3 -u "$DIR/ds4kbm.py" "$preset" "$@" >"$LOG" 2>&1 </dev/null 9>&- &
    child=$!
    i=0
    while ! running && kill -0 "$child" 2>/dev/null && [ $i -lt 30 ]; do sleep 0.1; i=$((i + 1)); done
    if ! running; then
        cat "$LOG" >&2
        exit 1
    fi
}

stop() {
    if running; then
        pid=$(head -n 1 "$PIDFILE")
        kill "$pid" 2>/dev/null
        i=0
        while running && [ $i -lt 30 ]; do sleep 0.1; i=$((i + 1)); done
        running && kill -9 "$pid" 2>/dev/null
        while running; do sleep 0.1; done
    fi
    # Leave no stale pid / preset behind for someone reading the file.
    [ -f "$PIDFILE" ] && : >"$PIDFILE"
    return 0
}

case "$1" in
    start)
        [ -n "$2" ] || { echo "usage: $0 start PRESET [options]" >&2; exit 2; }
        shift
        start "$@"
        ;;
    stop) stop ;;
    status)
        if running; then
            echo on
            sed -n 2p "$PIDFILE"
        else
            echo off
            exit 1
        fi
        ;;
    analyze) python3 "$DIR/ds4kbm.py" --analyze "$2" ;;
    *) echo "usage: $0 start PRESET [options] | stop | status | analyze DIR" >&2; exit 2 ;;
esac
